# Every value has a working default for the docker compose setup. Copy to .env only to override.
DATABASE_URL=postgresql://annotator:annotator@localhost:5432/annotation
PORT=3000
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
# Used for the mp3/m4a signal analysis. Defaults to `ffmpeg` on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
