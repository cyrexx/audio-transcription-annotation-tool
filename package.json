{
  "name": "audio-transcription-annotation-tool",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "setup": "yarn install && yarn db:migrate && yarn db:seed",
    "dev": "concurrently -n server,web -c blue,green \"yarn workspace server dev\" \"yarn workspace web dev\"",
    "db:migrate": "yarn workspace server db:migrate",
    "db:seed": "yarn workspace server db:seed",
    "test": "vitest run",
    "test:unit": "vitest run --project shared --project server:unit --project web",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
